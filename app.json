{
  "expo": {
    "newArchEnabled": true,
    "name": "Mama Meadow",
    "slug": "mama-meadow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mama.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/mama.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mamameadow.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Mama Meadow uses your photo library to add photos of your baby and capture monthly milestones.",
        "NSPhotoLibraryAddUsageDescription": "Mama Meadow saves your baby's milestone photos to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mama.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.mamameadow.app"
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "mamameadow",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "revenueCatApiKeyIos": "appl_UTNWeWnDwTGhztJUAXUepJFGweF",
      "revenueCatApiKeyAndroid": "test_iZztqPPicEhtQcqboEOpCrpasKW",
      "revenueCatEntitlementId": "pro"
    }
  }
}